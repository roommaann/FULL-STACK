@page "/"
@rendermode InteractiveServer
@inject IProductService ProductService


<div class="card p-3 mb-4 shadow-sm">
    <h4>@(isEditing ? "Update Product" : "Add New Product")</h4>
    <div class="row g-3 align-items-center">
        <div class="col-md-5">
            <input type="text" class="form-control" placeholder="Product Name" @bind="currentProduct.PName" />
        </div>
        <div class="col-md-4">
            <input type="number" class="form-control" placeholder="Price" @bind="currentProduct.Price" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            @if (isEditing)
            {
                <button class="btn btn-warning flex-grow-1" @onclick="HandleSave">Update</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            }
            else
            {
                <button class="btn btn-primary w-100" @onclick="HandleSave">Add Product</button>
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info mt-2 mb-0 py-1">@statusMessage</div>
    }
</div>

<h1>Product Information</h1>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in products)
        {
            <tr>
                <td>@item.PId</td>
                <td>@item.PName</td>
                <td>@item.Price</td>
                <td>
                    <button class="btn btn-warning btn-sm me-1" @onclick="() => StartEdit(item)">Edit</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => HandleDelete(item.PId)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code{
    ProductModel currentProduct = new ProductModel();
    List<ProductModel> products = new List<ProductModel>();
    string statusMessage = "";
    bool isEditing = false;

    protected override void OnInitialized()
    {
        LoadProducts();
    }

    void LoadProducts()
    {
        products = ProductService.GetAllData();
    }

    void StartEdit(ProductModel item)
    {
        isEditing = true;
        currentProduct = new ProductModel
        {
            PId = item.PId,
            PName = item.PName,
            Price = item.Price
        };
        statusMessage = $"Editing Product #{item.PId}";
    }

    void CancelEdit()
    {
        isEditing = false;
        currentProduct = new ProductModel();
        statusMessage = "";
    }

    void HandleSave()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(currentProduct.PName))
            {
                statusMessage = "Please enter a product name.";
                return;
            }

            if (isEditing)
            {
                bool success = ProductService.UpdateProduct(currentProduct);
                if (success)
                {
                    statusMessage = $"Product #{currentProduct.PId} updated successfully!";
                    CancelEdit();
                    LoadProducts();
                }
                else
                {
                    statusMessage = "Failed to update product.";
                }
            }
            else
            {
                bool success = ProductService.AddProduct(currentProduct);
                if (success)
                {
                    statusMessage = "Product added successfully!";
                    currentProduct = new ProductModel();
                    LoadProducts();
                }
                else
                {
                    statusMessage = "Failed to add product.";
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error: " + ex.Message;
        }
    }

    void HandleDelete(int id)
    {
        try
        {
            bool success = ProductService.DeleteProduct(id);
            if (success)
            {
                statusMessage = $"Product with ID {id} deleted successfully!";
                if (isEditing && currentProduct.PId == id)
                {
                    CancelEdit();
                }
                LoadProducts();
            }
            else
            {
                statusMessage = $"Failed to delete product with ID {id}.";
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error: " + ex.Message;
        }
    }
}