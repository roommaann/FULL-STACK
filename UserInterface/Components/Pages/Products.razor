@page "/products"
@rendermode InteractiveServer
@using Models
@using BusinessLogicLayer
@using Microsoft.AspNetCore.Components.Forms
@inject ProductService ProductService

<PageTitle>Product Management</PageTitle>

<h3>Product Management</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(message.Contains("failed", StringComparison.OrdinalIgnoreCase) || message.Contains("Could not", StringComparison.OrdinalIgnoreCase) ? "alert-danger" : "alert-success") alert-dismissible fade show" role="status">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null" aria-label="Close"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@(editing ? "Edit Product" : "Add New Product")</h5>
    </div>
    <div class="card-body">
        <EditForm Model="formProduct" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label fw-bold">Name</label>
                <InputText class="form-control" @bind-Value="formProduct.Name" placeholder="Enter product name" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <InputTextArea class="form-control" @bind-Value="formProduct.Description" rows="2" placeholder="Enter product description" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Price</label>
                    <InputNumber class="form-control" @bind-Value="formProduct.Price" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Stock quantity</label>
                    <InputNumber class="form-control" @bind-Value="formProduct.StockQuantity" />
                </div>
            </div>

            <button class="btn btn-primary" type="submit">
                @(editing ? "Update product" : "Add product")
            </button>
            @if (editing)
            {
                <button class="btn btn-secondary ms-2" type="button" @onclick="ResetForm">
                    Cancel
                </button>
            }
        </EditForm>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4>Product List</h4>
    <button class="btn btn-outline-primary" @onclick="LoadAsync">
        Refresh list
    </button>
</div>

@if (products is null)
{
    <p><em>Loading products...</em></p>
}
else if (products.Count == 0)
{
    <div class="alert alert-secondary">
        No products found. Add the first product above.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td class="fw-bold">@p.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(p.Description) ? "-" : p.Description)</td>
                        <td>$@p.Price.ToString("0.00")</td>
                        <td>
                            <span class="badge @(p.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                                @p.StockQuantity
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => Edit(p)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeleteAsync(p.ProductId)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Product>? products;
    private Product formProduct = new();
    private bool editing;
    private string? message;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            message = $"Could not load products. Check the connection and server logs. ({ex.Message})";
            products = new();
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (editing)
            {
                await ProductService.UpdateAsync(formProduct);
                message = "Product updated.";
            }
            else
            {
                await ProductService.AddAsync(formProduct);
                message = "Product added.";
            }

            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = $"Save failed. Check the server logs and database constraints. ({ex.Message})";
        }
    }

    private void Edit(Product product)
    {
        formProduct = new Product
        {
            ProductId = product.ProductId,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            StockQuantity = product.StockQuantity,
            CreatedAt = product.CreatedAt
        };
        editing = true;
        message = null;
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await ProductService.DeleteAsync(id);
            message = "Product deleted.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = $"Delete failed. Check the server logs. ({ex.Message})";
        }
    }

    private void ResetForm()
    {
        formProduct = new Product();
        editing = false;
    }
}
